# This file contains variable names and safe placeholders only.
# Never commit `.env` or paste real credentials into this example file.

# Neon pooled connection used by the running Next.js application.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Base64-encoded 32-byte key used to encrypt QuickBooks tokens and realm IDs.
# Generate privately, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY"

# Phase 2: Intuit sandbox credentials. These must remain server-only.
INTUIT_CLIENT_ID="REPLACE_WITH_INTUIT_DEVELOPMENT_CLIENT_ID"
INTUIT_CLIENT_SECRET="REPLACE_WITH_INTUIT_DEVELOPMENT_CLIENT_SECRET"
# This must exactly match the Development redirect URI registered with Intuit.
INTUIT_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"
INTUIT_ENVIRONMENT="sandbox"

# Pin a supported QuickBooks Online API minor version for predictable responses.
INTUIT_API_MINOR_VERSION="75"
