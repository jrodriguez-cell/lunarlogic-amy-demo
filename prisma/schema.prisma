generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuickBooksEnvironment {
  SANDBOX
  PRODUCTION
}

enum QuickBooksConnectionStatus {
  DISCONNECTED
  CONNECTED
  RECONNECT_REQUIRED
}

enum QuickBooksSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum QuickBooksReportType {
  BALANCE_SHEET
  PROFIT_AND_LOSS
  TRIAL_BALANCE
  AGED_RECEIVABLES
  AGED_PAYABLES
}

model Organization {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  legalEntities LegalEntity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model LegalEntity {
  id                   String                @id @default(cuid())
  organizationId       String
  key                  String
  name                 String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quickBooksConnection QuickBooksConnection?
  quickBooksOAuthStates QuickBooksOAuthState[]
  quickBooksAccounts   QuickBooksAccount[]
  quickBooksReports    QuickBooksReportSnapshot[]
  quickBooksSyncRuns   QuickBooksSyncRun[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model QuickBooksConnection {
  id                     String                     @id @default(cuid())
  legalEntityId          String                     @unique
  environment            QuickBooksEnvironment      @default(SANDBOX)
  status                 QuickBooksConnectionStatus @default(DISCONNECTED)
  realmIdCiphertext      String?                    @db.Text
  realmIdHash            String?
  accessTokenCiphertext  String?                    @db.Text
  refreshTokenCiphertext String?                    @db.Text
  scopes                 String[]                   @default([])
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  hardExpiresAt          DateTime?
  companyName            String?
  connectedAt            DateTime?
  lastSyncedAt           DateTime?
  refreshLockId          String?
  refreshLockedAt        DateTime?
  legalEntity            LegalEntity                @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([environment, realmIdHash])
  @@index([status])
}

model QuickBooksOAuthState {
  id            String      @id @default(cuid())
  stateHash     String      @unique
  legalEntityId String
  expiresAt     DateTime
  consumedAt    DateTime?
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([legalEntityId])
  @@index([expiresAt])
}

model QuickBooksAccount {
  id                 String      @id @default(cuid())
  legalEntityId      String
  quickBooksId       String
  syncToken          String?
  name               String
  fullyQualifiedName String?
  classification     String?
  accountType        String
  accountSubType     String?
  currentBalance     Decimal?    @db.Decimal(18, 2)
  active             Boolean     @default(true)
  sourceUpdatedAt    DateTime?
  syncedAt           DateTime    @default(now())
  legalEntity        LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([legalEntityId, quickBooksId])
  @@index([legalEntityId, accountType])
  @@index([legalEntityId, active])
}

model QuickBooksSyncRun {
  id            String               @id @default(cuid())
  legalEntityId String
  status        QuickBooksSyncStatus @default(RUNNING)
  source        String               @default("manual")
  recordCounts  Json?                @db.JsonB
  warnings      String[]             @default([])
  errorSummary  String?
  startedAt     DateTime             @default(now())
  finishedAt    DateTime?
  legalEntity   LegalEntity          @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  reports       QuickBooksReportSnapshot[]

  @@index([legalEntityId, startedAt])
  @@index([status])
}

model QuickBooksReportSnapshot {
  id            String               @id @default(cuid())
  legalEntityId String
  syncRunId     String
  reportType    QuickBooksReportType
  reportName    String
  basis         String?
  currency      String?
  startPeriod   String?
  endPeriod     String?
  reportTime    DateTime?
  payload       Json                 @db.JsonB
  fetchedAt     DateTime             @default(now())
  legalEntity   LegalEntity          @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  syncRun       QuickBooksSyncRun    @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([legalEntityId, reportType, fetchedAt])
  @@index([syncRunId])
}
